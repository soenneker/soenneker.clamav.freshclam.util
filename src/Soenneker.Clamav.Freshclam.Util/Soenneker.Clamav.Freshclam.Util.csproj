<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A cross-platform .NET utility for updating ClamAV virus definitions with bundled FreshClam runtimes.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Clamav.Freshclam.Util</AssemblyName>
        <PackageId>Soenneker.Clamav.Freshclam.Util</PackageId>
        <PackageTags>clamav freshclam util cross-platform antivirus definitions updater utility freshclamutil</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.clamav.freshclam.util</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.clamav.freshclam.util</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Soenneker.Extensions.Task" Version="4.0.128" />
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.120" />
        <PackageReference Include="Soenneker.Clamav.Freshclam.Linux" Version="4.0.6" PrivateAssets="analyzers;build" />
        <PackageReference Include="Soenneker.Clamav.Freshclam.Windows" Version="4.0.4" PrivateAssets="analyzers;build" />
        <PackageReference Include="Soenneker.Utils.Directory" Version="4.0.916" />
        <PackageReference Include="Soenneker.Utils.File" Version="4.0.2246" />
        <PackageReference Include="Soenneker.Utils.Path" Version="4.0.1209" />
        <PackageReference Include="Soenneker.Utils.Paths.Resources" Version="4.0.229" />
        <PackageReference Include="Soenneker.Utils.PooledStringBuilders" Version="4.0.29" />
        <PackageReference Include="Soenneker.Utils.Process" Version="4.0.1534" />
        <PackageReference Include="Soenneker.Utils.Runtime" Version="4.0.1086" />
    </ItemGroup>
</Project>
